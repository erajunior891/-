{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "colosseum:gladiator_heavy",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "runtime_identifier": "minecraft:zombie"
    },
    "components": {
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 10 : 0"
      },
      "minecraft:type_family": {
        "family": [
          "gladiator",
          "monster",
          "mob"
        ]
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:nameable": {},
      "minecraft:health": {
        "value": 45,
        "max": 45
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:movement": {
        "value": 0.28
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:collision_box": {
        "width": 0.63,
        "height": 1.8900000000000001
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/gladiator_heavy.json"
      },
      "minecraft:equipment": {
        "table": "loot_tables/equipment/gladiator_heavy_gear.json"
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:scale": {
        "value": 1.05
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": false,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            },
            "max_dist": 48
          }
        ]
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.8
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 8.0,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
      "minecraft:knockback_resistance": {
        "value": 0.5
      },
      "minecraft:attack": {
        "damage": 6
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "speed_multiplier": 1.2,
        "track_target": true
      },
      "minecraft:mark_variant": {
        "value": 0
      }
    },
    "component_groups": {
      "colosseum:combat": {
        "minecraft:mark_variant": {
          "value": 0
        },
        "minecraft:damage_sensor": {
          "damage_conditions": [
            {
              "cause": "entity_attack",
              "deals_damage": true,
              "on_damage": {
                "event": "colosseum:start_blocking",
                "filters": {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                }
              }
            },
            {
              "cause": "projectile",
              "deals_damage": true,
              "on_damage": {
                "event": "colosseum:start_blocking"
              }
            }
          ]
        }
      },
      "colosseum:blocking": {
        "minecraft:mark_variant": {
          "value": 1
        },
        "minecraft:damage_sensor": {
          "damage_conditions": [
            {
              "cause": "entity_attack",
              "deals_damage": false,
              "damage_modifier": 0.0,
              "on_damage_sound_event": "item.shield.block"
            },
            {
              "cause": "projectile",
              "deals_damage": false,
              "damage_modifier": 0.0,
              "on_damage_sound_event": "item.shield.block"
            }
          ]
        },
        "minecraft:movement": {
          "value": 0.26
        },
        "minecraft:timer": {
          "time": [
            1.0,
            1.4
          ],
          "looping": false,
          "time_down_event": {
            "event": "colosseum:stop_blocking"
          }
        }
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "colosseum:combat"
          ]
        }
      },
      "colosseum:start_blocking": {
        "remove": {
          "component_groups": [
            "colosseum:combat"
          ]
        },
        "add": {
          "component_groups": [
            "colosseum:blocking"
          ]
        }
      },
      "colosseum:stop_blocking": {
        "remove": {
          "component_groups": [
            "colosseum:blocking"
          ]
        },
        "add": {
          "component_groups": [
            "colosseum:combat"
          ]
        }
      }
    }
  }
}