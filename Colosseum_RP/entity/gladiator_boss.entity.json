{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "colosseum:gladiator_boss",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/gladiator_boss",
        "plume": "textures/entity/knights_big_plume_red"
      },
      "geometry": {
        "default": "geometry.gladiator",
        "plume": "geometry.gladiator_plume"
      },
      "scripts": {
        "scale": "0.9375",
        "initialize": [
          "variable.is_holding_right = 0.0;",
          "variable.is_holding_left = 0.0;",
          "variable.attack_time = 0.0;",
          "variable.attack_body_rot_y = 0.0;"
        ],
        "pre_animation": [
          "variable.tcos0 = (math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / 0.13) * 57.3;",
          "variable.attack_time = query.attack_time;",
          "variable.attack_body_rot_y = math.sin(360.0 * math.sqrt(variable.attack_time)) * 5.0;",
          "variable.is_holding_right = query.is_item_name_any('slot.weapon.mainhand', 0, 'colosseum:gladius', 'colosseum:start_fight', 'colosseum:trophy', 'minecraft:iron_sword', 'minecraft:diamond_sword', 'minecraft:golden_sword', 'minecraft:bow');",
          "variable.is_holding_left = query.is_item_name_any('slot.weapon.offhand', 0, 'colosseum:shield', 'minecraft:shield');"
        ],
        "animate": [
          "look_at_target",
          "gladiator_movement",
          "gladiator_combat"
        ]
      },
      "animations": {
        "humanoid_base_pose": "animation.humanoid.base_pose",
        "look_at_target": "animation.humanoid.look_at_target.default",
        "gladiator_idle": "animation.colosseum.gladiator.idle",
        "move.arms": "animation.colosseum.gladiator.move.arms",
        "move.legs": "animation.colosseum.gladiator.move.legs",
        "sprint": "animation.colosseum.gladiator.sprint",
        "gladiator_attack": "animation.colosseum.gladiator.attack",
        "gladiator_movement": "controller.animation.colosseum.gladiator.movement",
        "gladiator_combat": "controller.animation.colosseum.gladiator.attack"
      },
      "render_controllers": [
        "controller.render.gladiator",
        "controller.render.gladiator_plume"
      ],
      "enable_attachables": true,
      "spawn_egg": {
        "base_color": "#19191E",
        "overlay_color": "#FF2828"
      }
    }
  }
}