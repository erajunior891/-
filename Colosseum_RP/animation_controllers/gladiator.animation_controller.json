{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.colosseum.gladiator.movement": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "gladiator_idle"
          ],
          "transitions": [
            {
              "walk": "query.modified_move_speed > 0.05"
            }
          ],
          "blend_transition": 0.15
        },
        "walk": {
          "animations": [
            "move.arms",
            "move.legs"
          ],
          "transitions": [
            {
              "sprint": "query.is_sprinting"
            },
            {
              "idle": "query.modified_move_speed <= 0.05"
            }
          ],
          "blend_transition": 0.15
        },
        "sprint": {
          "animations": [
            "move.arms",
            "move.legs",
            "sprint"
          ],
          "transitions": [
            {
              "walk": "!query.is_sprinting && query.modified_move_speed > 0.05"
            },
            {
              "idle": "query.modified_move_speed <= 0.05"
            }
          ],
          "blend_transition": 0.15
        }
      }
    },
    "controller.animation.colosseum.gladiator.attack": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "attacking": "query.is_delayed_attacking"
            }
          ],
          "blend_transition": 0.05
        },
        "attacking": {
          "animations": [
            "gladiator_attack"
          ],
          "transitions": [
            {
              "default": "!query.is_delayed_attacking"
            }
          ],
          "blend_transition": 0.1
        }
      }
    },
    "controller.animation.colosseum.gladiator.shield": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "blocking": "query.mark_variant == 1"
            }
          ],
          "blend_transition": 0.12
        },
        "blocking": {
          "animations": [
            "gladiator_block"
          ],
          "transitions": [
            {
              "default": "query.mark_variant == 0"
            }
          ],
          "blend_transition": 0.12
        }
      }
    },
    "controller.animation.colosseum.gladiator.bow": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "aiming": "query.is_using_item"
            }
          ],
          "blend_transition": 0.15
        },
        "aiming": {
          "animations": [
            "gladiator_bow_aim"
          ],
          "transitions": [
            {
              "default": "!query.is_using_item"
            }
          ],
          "blend_transition": 0.15
        }
      }
    }
  }
}